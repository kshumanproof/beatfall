# ---------------------------------------------------------------------------
# Copy these into Vercel → Project → Settings → Environment Variables.
# Nothing here belongs in git. .gitignore already excludes .env files.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # safe in the browser; row-level security is the real guard
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # SERVER ONLY. Never put this anywhere a browser can read.

# Anthropic → console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-...

# Stripe → Developers → API keys.  Use the TEST keys (sk_test_…) while testing.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...     # from the webhook endpoint you create in Stripe

# Stripe → Products. Create three recurring prices and one one-off, paste the price ids.
STRIPE_PRICE_WRITER=price_...       # $19 / month
STRIPE_PRICE_WORKING=price_...      # $29 / month
STRIPE_PRICE_VOLUME=price_...       # $39 / month
STRIPE_PRICE_TOPUP=price_...        # $6 one-off, 100 credits

# Your live address, no trailing slash. Used for Stripe redirects.
SITE_URL=https://beatfall.app
