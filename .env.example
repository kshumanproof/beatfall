# ---------------------------------------------------------------------------
# Copy these into Vercel → Project → Settings → Environment Variables.
# Nothing here belongs in git. .gitignore already excludes .env files.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # safe in the browser; row-level security is the real guard
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # SERVER ONLY. Never put this anywhere a browser can read.

# Anthropic → console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-...

# Stripe → Developers → API keys.  Use the TEST keys (sk_test_…) while testing.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...     # from the webhook endpoint you create in Stripe

# Stripe → Products. One product, two recurring prices, plus a one-off top-up.
STRIPE_PRICE_MONTHLY=price_...      # $15 / month
STRIPE_PRICE_ANNUAL=price_...       # $149 / year
STRIPE_PRICE_TOPUP=price_...        # $6 one-off, 25 credits

# Your live address, no trailing slash. Used for Stripe redirects.
SITE_URL=https://beatfall-beta.vercel.app   # the real domain goes here at launch

# --- the six-month cleanup -------------------------------------------------
# An account nobody signs into for six months, with no live subscription, is
# deleted along with everything in it. /api/cleanup runs daily on Vercel's
# scheduler and refuses to do anything unless this is set.
CRON_SECRET=

# The five-month warning email. Without these the job still deletes on time,
# it just goes out silently, which is not what the Privacy Policy promises.
RESEND_API_KEY=
MAIL_FROM=Beatfall <hello@beatfall.app>

# --- where the cost and problem alerts go ----------------------------------
# The admin system raises an alert when one account's provider cost crosses
# $8 in its allowance period, and an urgent one at $10. Both are sent the
# moment the line is crossed, and anything still unanswered is repeated in
# the nightly digest.
#
# WITHOUT THIS THEY ARE RECORDED AND NOTHING IS SENT. The System screen in
# the admin says so in red rather than looking healthy, but a page nobody
# opened is not a warning. Set it.
ALERT_TO=
