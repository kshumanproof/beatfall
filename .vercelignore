# The phone app ships to Apple and Google, not to Vercel. Keeping it out of
# the deployment bundle saves upload time and makes it obvious that nothing
# under mobile/ is ever served from beatfall.app.
mobile/
_to_delete/
_testdata/
handoff/

# The offline UI suite. It runs against public/app.html and is never served.
test/

# The master artwork and the script that cuts the brand assets from it. Source,
# not product: the PNGs it writes are what ships.
brand-src/
